# Configuration non secrète des Cloud Functions (les secrets restent dans
# Google Secret Manager : PLAID_CLIENT_ID, PLAID_SECRET, REVENUECAT_WEBHOOK_AUTH).
#
# En production, créer un fichier .env.<project-id-prod> avec :
#   PLAID_ENV=production
#   ENFORCE_APP_CHECK=true

# Environnement Plaid : sandbox | production
# Passé en production le 22 juillet 2026 (accès production limité accordé
# par Plaid) : horizon-dbba0 héberge désormais de vraies données bancaires.
# Voir PRODUCTION_CHECKLIST.md §5 bis.
PLAID_ENV=production

# URL de retour après authentification OAuth d'une banque (Web).
# ⚠️ Doit correspondre EXACTEMENT à une entrée de
# Plaid → Team Settings → API → Allowed redirect URIs, barre oblique finale
# comprise, sinon linkTokenCreate échoue et aucune banque ne se connecte.
PLAID_REDIRECT_URI=https://horizon-dbba0.web.app/

# Exiger un jeton App Check valide sur les fonctions appelables (anti-bot).
# Activer une fois Play Integrity / App Attest / reCAPTCHA configurés.
ENFORCE_APP_CHECK=false

# Ne JAMAIS mettre à true en production : désactive la vérification de
# signature des webhooks Plaid (utile seulement avec l'émulateur local).
PLAID_SKIP_WEBHOOK_VERIFICATION=false

# Coach IA : réserver aux abonnés Premium (mettre true en production).
AI_COACH_REQUIRE_PREMIUM=false

# Demander le produit Plaid « liabilities » (échéances, soldes de relevé et
# paiements minimums des cartes de crédit) quand l'institution le supporte.
# ⚠️ Exige que le produit soit activé sur le compte Plaid : sans cette
# autorisation, la création du link_token échoue pour TOUTES les
# institutions. En cas de doute, remettre à false et redéployer
# generatePlaidLinkToken — aucun changement de code n'est nécessaire.
# ⚠️ Facturé dès l'initialisation d'un Item, et non retirable ensuite.
PLAID_ENABLE_LIABILITIES=true

# Nombre de connexions bancaires autorisées sans abonnement.
# Relevé à 5 pendant le pilote pour réunir comptes bancaires et cartes de
# crédit de plusieurs institutions (Tangerine + CIBC). À ramener à 1 avant
# toute commercialisation, sans quoi le plan gratuit vide l'argument Premium.
FREE_PLAN_BANK_LIMIT=5
