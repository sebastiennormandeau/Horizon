# Configuration non secrète des Cloud Functions (les secrets restent dans
# Google Secret Manager : PLAID_CLIENT_ID, PLAID_SECRET, REVENUECAT_WEBHOOK_AUTH).
#
# En production, créer un fichier .env.<project-id-prod> avec :
#   PLAID_ENV=production
#   ENFORCE_APP_CHECK=true

# Environnement Plaid : sandbox | production
PLAID_ENV=sandbox

# Exiger un jeton App Check valide sur les fonctions appelables (anti-bot).
# Activer une fois Play Integrity / App Attest / reCAPTCHA configurés.
ENFORCE_APP_CHECK=false

# Ne JAMAIS mettre à true en production : désactive la vérification de
# signature des webhooks Plaid (utile seulement avec l'émulateur local).
PLAID_SKIP_WEBHOOK_VERIFICATION=false

# Coach IA : réserver aux abonnés Premium (mettre true en production).
AI_COACH_REQUIRE_PREMIUM=false
