rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function userHouseholdId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.household_id;
    }

    function isUserInHousehold(householdId) {
      return isAuthenticated() && userHouseholdId() == householdId;
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      // household_id et role sont gérés exclusivement par les Cloud Functions.
      allow create: if isAuthenticated() && request.auth.uid == userId
        && !request.resource.data.keys().hasAny(['household_id', 'role']);
      allow update: if isAuthenticated() && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['household_id', 'role']);
      allow delete: if false;
    }

    match /households/{householdId} {
      allow read: if isUserInHousehold(householdId);
      // La création et l'adhésion passent par les Cloud Functions (createHousehold / joinHousehold).
      // Les membres peuvent ajuster les cagnottes/budget, mais pas l'identité du foyer.
      allow update: if isUserInHousehold(householdId)
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['join_code', 'user_A_id', 'user_B_id', 'created_by', 'created_at']);
      allow create, delete: if false;

      match /monthly_budgets/{budgetId} {
        allow read, write: if isUserInHousehold(householdId);
      }
    }

    // Contient les access_token Plaid : accessible uniquement via l'Admin SDK.
    match /bank_connections/{connectionId} {
      allow read, write: if false;
    }

    match /transactions/{transactionId} {
      allow read: if isAuthenticated()
        && resource.data.household_id == userHouseholdId();
      // Seule l'assignation de bucket est modifiable côté client.
      allow update: if isAuthenticated()
        && resource.data.household_id == userHouseholdId()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['assigned_to_bucket'])
        && request.resource.data.assigned_to_bucket in ['', 'Solo_A', 'Solo_B', 'Common'];
      allow create, delete: if false;
    }
  }
}
